# Machine-specific tooling config (paths contain local usernames)
.claude/

# Personal flight data — never commit logbook exports
*.csv

# Scan-accuracy fixtures: photographs of real logbook pages, plus the truth
# files transcribing them. Same rule as the CSVs. The README and the format
# example are the only things here that belong in the repo.
evals/fixtures/scans/*
!evals/fixtures/scans/README.md
!evals/fixtures/scans/example.json

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo

# Secrets — never commit credentials
.env
.env.*
!.env.example
*.key
*.pem

# Node
node_modules/
npm-debug.log*

# Next.js
.next/
out/
next-env.d.ts
*.tsbuildinfo

# Vercel
.vercel/

# Supabase CLI (local state)
supabase/.temp/
supabase/.branches/
