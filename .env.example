# Supabase Auth + RLS. BOTH values are public and safe to expose in the browser
# and in your deployment host — the anon/publishable key respects Row Level
# Security, and this app uses no service-role/secret key at all.
# Copy to `.env.local` and fill in. Leave empty to run fully local-only.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Project Settings → API keys → anon / publishable key (sb_publishable_… or the
# legacy anon JWT). NOT the service_role/secret key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
