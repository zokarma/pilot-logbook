# Supabase — the primary data store for the Next.js app.
# Copy this file to `.env.local` and fill in your project values.

# Public project URL (safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Service-role key — SERVER ONLY. Never prefix with NEXT_PUBLIC_.
# Used exclusively by the /api routes to read/write on behalf of a signed-in user.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
